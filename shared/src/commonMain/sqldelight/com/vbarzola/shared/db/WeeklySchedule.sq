CREATE TABLE IF NOT EXISTS weekly_schedule (
    id INTEGER NOT NULL PRIMARY KEY,
    professional_id INTEGER NOT NULL,
    day_of_week TEXT NOT NULL,
    start_time TEXT NOT NULL,
    end_time TEXT NOT NULL,
    slot_duration_minutes INTEGER NOT NULL,
    enabled INTEGER NOT NULL DEFAULT 1,
    FOREIGN KEY (professional_id) REFERENCES professional(id)
);

selectByProfessional:
SELECT * FROM weekly_schedule
WHERE professional_id = :professionalId AND enabled = 1;

upsert:
INSERT OR REPLACE INTO weekly_schedule(id, professional_id, day_of_week, start_time, end_time, slot_duration_minutes, enabled)
VALUES (:id, :professionalId, :dayOfWeek, :startTime, :endTime, :slotDurationMinutes, :enabled);

deleteAll:
DELETE FROM weekly_schedule;
