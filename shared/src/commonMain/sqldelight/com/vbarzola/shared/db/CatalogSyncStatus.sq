CREATE TABLE IF NOT EXISTS catalog_sync_status (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
    local_version INTEGER NOT NULL,
    applied_at TEXT NOT NULL
);

get:
SELECT * FROM catalog_sync_status WHERE id = 1;

upsert:
INSERT OR REPLACE INTO catalog_sync_status(id, local_version, applied_at)
VALUES (1, :localVersion, :appliedAt);
