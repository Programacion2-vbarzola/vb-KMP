CREATE TABLE IF NOT EXISTS professional (
    id INTEGER NOT NULL PRIMARY KEY,
    category_id INTEGER NOT NULL,
    first_name TEXT NOT NULL,
    last_name TEXT NOT NULL,
    enabled INTEGER NOT NULL DEFAULT 1,
    updated_at TEXT NOT NULL,
    FOREIGN KEY (category_id) REFERENCES professional_category(id)
);

selectAll:
SELECT p.id, p.category_id, p.first_name, p.last_name, p.enabled, p.updated_at,
       c.name AS category_name
FROM professional p
JOIN professional_category c ON p.category_id = c.id
ORDER BY p.last_name ASC;

selectEnabled:
SELECT p.id, p.category_id, p.first_name, p.last_name, p.enabled, p.updated_at,
       c.name AS category_name
FROM professional p
JOIN professional_category c ON p.category_id = c.id
WHERE p.enabled = 1
ORDER BY p.last_name ASC;

selectByCategory:
SELECT p.id, p.category_id, p.first_name, p.last_name, p.enabled, p.updated_at,
       c.name AS category_name
FROM professional p
JOIN professional_category c ON p.category_id = c.id
WHERE p.category_id = :categoryId AND p.enabled = 1
ORDER BY p.last_name ASC;

searchByName:
SELECT p.id, p.category_id, p.first_name, p.last_name, p.enabled, p.updated_at,
       c.name AS category_name
FROM professional p
JOIN professional_category c ON p.category_id = c.id
WHERE (p.first_name LIKE '%' || :query || '%' OR p.last_name LIKE '%' || :query || '%')
AND p.enabled = 1
ORDER BY p.last_name ASC;

selectById:
SELECT p.id, p.category_id, p.first_name, p.last_name, p.enabled, p.updated_at,
       c.name AS category_name
FROM professional p
JOIN professional_category c ON p.category_id = c.id
WHERE p.id = :id;

upsert:
INSERT OR REPLACE INTO professional(id, category_id, first_name, last_name, enabled, updated_at)
VALUES (:id, :categoryId, :firstName, :lastName, :enabled, :updatedAt);

deleteAll:
DELETE FROM professional;
